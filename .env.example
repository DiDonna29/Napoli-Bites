# Plantilla de variables de entorno para Firebase
# Copia este archivo a .env.local y llena los valores con tus credenciales reales de Firebase.
# ¡NUNCA subas tu archivo .env.local a un repositorio Git!

# Esenciales de Firebase (Obtenlos de tu Consola de Firebase -> Configuración del Proyecto -> General -> Tus apps -> Configuración del SDK)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_API_KEY_HERE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID_HERE.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID_HERE"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID_HERE.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID_HERE"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID_HERE"

# Opcional, para Google Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID_HERE_IF_ANY"
