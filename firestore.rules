
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection:
    // - Allow authenticated users to read their own profile.
    // - Allow authenticated users to create their own profile document.
    // - Allow authenticated users to update their own profile document.
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      // Consider 'delete' permissions separately if users should be able to delete their accounts.
      // allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection:
    // - Allow authenticated users to create new orders.
    //   The 'userId' field in the new order document must match the authenticated user's UID.
    // - Allow authenticated users to read their own orders.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Consider 'update' or 'delete' permissions for orders based on app requirements (e.g., order cancellation).
      // For example, to allow a user to update (cancel) their own order:
      // allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
